# Mẫu cấu hình. Copy thành secrets.toml và điền key thật (file thật KHÔNG commit).
SUPABASE_URL = "https://<project-id>.supabase.co"
SUPABASE_ANON_KEY = "<anon key>"
SUPABASE_SERVICE_ROLE_KEY = "<service_role key>"

# (tùy chọn) Hermes agent thật qua HTTP shim trên VPS — xem vps/README.md
HERMES_API_URL = "https://api-hermes.<domain>"
HERMES_API_KEY = "<bearer token của shim>"

# (tùy chọn) Hermes Agent dashboard (web UI) nhúng trong tab Manage. Mặc định localhost:9119.
HERMES_DASHBOARD_URL = "http://localhost:9119"

# (tùy chọn) SEO Pipeline → tab Deploy: Netlify Personal Access Token (User settings →
# Applications → New access token). Thiếu key này thì nút Deploy bị vô hiệu + hiện cảnh báo.
NETLIFY_AUTH_TOKEN = "<netlify personal access token>"

# (tùy chọn) Nút "Join AIPB" trong Workspace live-preview (landing/index/testimonials).
# Thiếu key này thì nút tự ẩn (không hiện link chết). Điền link cộng đồng AI Profit Boardroom.
AIPB_URL = "https://www.skool.com/<your-aipb-community>"

# (tùy chọn) Đổi link các nút "Mở ..." — đều có mặc định, không bắt buộc
ANTIGRAVITY_URL = "https://antigravity.google"
CLAUDE_URL = "https://claude.ai"
GEMINI_URL = "https://gemini.google.com"
CODEX_URL = "https://chatgpt.com/codex"

# (tùy chọn) Studio launchpad — ghi đè link công cụ media, đều có mặc định
# STUDIO_HIGGSFIELD_URL = "https://higgsfield.ai"
# STUDIO_GAMMA_URL = "https://gamma.app"
# STUDIO_CANVA_URL = "https://www.canva.com"
# STUDIO_FIGMA_URL = "https://figma.com"
# STUDIO_N8N_URL = "https://your-n8n-instance"
# STUDIO_ELEVENLABS_URL = "https://elevenlabs.io"

# (cấu hình sync local, không phải secret) Vault Obsidian cho scripts/run_sync.py + Task Scheduler
OBSIDIAN_VAULT_PATH = "D:/path/to/your/obsidian-vault"
